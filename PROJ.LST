1     8				     READ_STRING MACRO BUF
1     9					 PUSH DX
1    10					 PUSH AX
1    11					 LEA DX,BUF  ; moves the memory	location of the	buffer into DX,
1    12					 ; which is what this macro requires
1    13					 MOV AH, 0AH
1    14					 INT 21H
1    15					 POP AX
1    16					 POP DX
1    17					 ; push	and pop	registers so as	to not overwrite them
1    18				     ENDM
1    19
1    20				     ; before calling this, string HAS to end with $
1    21				     ; or better: 13, 10, '$'  ( CRLF )	( if I want to start a new line	after that )
1    22				     PRINT_STRING MACRO	MESSAGE
1    23					 PUSH AX
1    24					 PUSH DX
1    25					 LEA DX, MESSAGE
1    26					 MOV AH, 09H
1    27					 ; this	means print everything in memory until $
1    28					 INT 21H
1    29					 POP DX
1    30					 POP AX
1    31
1    32				     ENDM
1    33
1    34				     PRINT_CHAR	MACRO CHAR ; we	will use this to print a number
1    35					 PUSH AX
1    36					 PUSH DX
1    37
1    38					 MOV AH,02H
1    39					 MOV DL, BYTE PTR CHAR
1    40					 INT 21H
1    41
1    42					 POP DX
1    43					 POP AX
1    44
1    45				     ENDM
