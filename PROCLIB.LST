1     7				     READ_STRING MACRO BUF
1     8					 PUSH DX
1     9					 PUSH AX
1    10					 LEA DX,BUF  ; moves the memory	location of the	buffer into DX,
1    11					 ; which is what this macro requires
1    12					 MOV AH, 0AH
1    13					 INT 21H
1    14					 POP AX
1    15					 POP DX
1    16					 ; push	and pop	registers so as	to not overwrite them
1    17				     ENDM
1    18
1    19				     ; before calling this, string HAS to end with $
1    20				     ; or better: 13, 10, '$'  ( CRLF )	( if I want to start a new line	after that )
1    21				     PRINT_STRING MACRO	MESSAGE
1    22					 PUSH AX
1    23					 PUSH DX
1    24					 LEA DX, MESSAGE
1    25					 MOV AH, 09H
1    26					 ; this	means print everything in memory until $
1    27					 INT 21H
1    28					 POP DX
1    29					 POP AX
1    30
1    31				     ENDM
1    32
1    33				     PRINT_CHAR	MACRO CHAR ; we	will use this to print a number
1    34					 PUSH AX
1    35					 PUSH DX
1    36
1    37					 MOV AH,02H
1    38					 MOV DL, BYTE PTR CHAR
1    39					 INT 21H
1    40
1    41					 POP DX
1    42					 POP AX
1    43
1    44				     ENDM
1    45
